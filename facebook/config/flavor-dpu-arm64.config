# DPU AP (arm64) flavor -- config the E1 DPU AP needs that must NOT ride the
# general arm64 fleet. Serves both DPU deployments (xSight + Intel ACC).
#
# xSight: the E1 RMC datapath functions (HIS/HIU) have no IOMMU group, so the XSL
# transport binds them via VFIO no-IOMMU. VFIO_NOIOMMU is a bool compiled into
# vfio.ko; without it vfio-pci probe on the RMC functions fails -EINVAL, and the
# enable_unsafe_noiommu_mode sysfs knob deploy-tools flips at runtime only exists
# when it is set. It is unsafe (no DMA isolation) -- confine it to the DPU flavor.
CONFIG_VFIO_NOIOMMU=y
#
# Intel ACC: CONFIG_SUSPEND is required for the Intel ACC legacy kexec_load path.
# Base arm64 leaves it off (servers do not suspend); it belongs to the DPU AP
# only, so carry it here rather than flipping it on for the whole fleet.
CONFIG_SUSPEND=y
