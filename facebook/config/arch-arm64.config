# CONFIG_TCG_FTPM_TEE is not set
CONFIG_TCG_TIS_SPI=y
# CONFIG_TCG_TIS_SPI_CR50 is not set
CONFIG_ARM64_64K_PAGES=y

# these were already set by default. Just keeping them here
# To make sure they are enabled if these features are disabled
# in common configuration
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_HAVE_PREEMPT_DYNAMIC=y
CONFIG_PREEMPT_NONE=y
CONFIG_NR_CPUS=512
CONFIG_BLK_DEV_PMEM=m
CONFIG_HOTPLUG_PCI_PCIE=y
CONFIG_PCIE_DPC=y
CONFIG_PCIE_EDR=y
CONFIG_MTD_SPI_NOR=y
CONFIG_IPMI_SSIF=m

CONFIG_ARM64_PMEM=y
# CONFIG_DEBUG_PREEMPT is not set
# CONFIG_PREEMPT_TRACER is not set
# CONFIG_PREEMPT_RT is not set
# CONFIG_TEST_HMM is not set
CONFIG_CLOCKSOURCE_WATCHDOG_MAX_SKEW_US=125

CONFIG_INFINIBAND_IPOIB=y
CONFIG_INFINIBAND_IPOIB_DEBUG=y

CONFIG_TRANSPARENT_HUGEPAGE_NEVER=y


# 6.13 is planned to have experimental LIVEPATCH support
CONFIG_LIVEPATCH=y

# CONFIG_COMPRESSED_INSTALL is not set
# CONFIG_NUMA_EMU is not set
# CONFIG_TEGRA_ACONNECT is not set
# CONFIG_IMX_SCMI_BBM_EXT is not set
# CONFIG_REGULATOR_ARM_SCMI is not set
# CONFIG_REGULATOR_VCTRL is not set
# CONFIG_AMD_QDMA is not set
#
# CONFIG_COMPAT is not set
# CONFIG_COMPAT_VDSO is not set


# These are required by NVIDIA according to
# https://docs.nvidia.com/grace/patches-config-guide/platform-software-patches-config.html
CONFIG_SENSORS_ACPI_POWER=m
CONFIG_USB_XHCI_PCI_RENESAS=m
CONFIG_FWCTL=m
CONFIG_FWCTL_MLX5=m

CONFIG_ARM64_PSEUDO_NMI=y
# CONFIG_ARM64_PSEUDO_NMI_RUNTIME is not set


# This causes a bunch of IPI on big machines, causing some stalls
# See https://lore.kernel.org/all/aag4tTyeiZyw0jID@gmail.com/
CONFIG_KFENCE_STATIC_KEYS=n


# Use a 2M pageblock instead of the 512M one we get by default.
# With CONFIG_ARM64_64K_PAGES the PMD size is 512M, so pageblock_order
# ends up as min(HUGETLB_PAGE_ORDER, PAGE_BLOCK_MAX_ORDER) = 13, i.e. a
# 512M pageblock. 64K << 5 == 2M, matching the x86_64 pageblock size.
CONFIG_PAGE_BLOCK_MAX_ORDER=5
