load("//facebook/bzl:flavors.td.bzl", "ARCHITECTURES", "ARCH_FLAVORS")
load("//facebook/bzl:config.bzl", "kernel_config", "generate_all", "validate_materialized")
load("//facebook/bzl:bootconfig.bzl", "kernel_bootconfig")

validate_materialized()
generate_all()

filegroup(
    name = "files",
    srcs = glob(["*.config", "*.bootconfig"]),
)

[
    (
        kernel_config(
            arch = arch,
        ),
        kernel_bootconfig(
            arch = arch,
            srcs = glob(["*.bootconfig"]),
        ),
        [
            (
                kernel_config(
                arch = arch,
                flavor = flavor,
            ),
                kernel_bootconfig(
                arch = arch,
                flavor = flavor,
                srcs = glob(["*.bootconfig"]),
            ),
            )
            for flavor in ARCH_FLAVORS[arch]
        ],
    )
    for arch in ARCHITECTURES
]
